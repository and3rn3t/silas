{
  "name": "silas-anderson-website",
  "version": "1.0.0",
  "description": "Personal website with embedded RPG game for Silas Anderson",
  "main": "script.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:fast": "playwright test --project=chromium",
    "test:e2e:smoke": "playwright test navigation.spec.js --project=chromium",
    "test:e2e:desktop": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:e2e:mobile": "playwright test --project=\"Mobile Chrome\" --project=\"Mobile Safari\"",
    "test:e2e:ci": "npm run serve & wait-on http://localhost:3000 --timeout 30000 && playwright test",
    "test:e2e:quick": "playwright test --project=chromium --workers=4",
    "serve": "npx http-server . -p 3000 -c-1",
    "deploy": "npx wrangler pages deploy . --project-name silas-anderson",
    "lint": "eslint *.js",
    "lint:fix": "eslint *.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lighthouse": "lhci autorun",
    "audit": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix",
    "dev": "npm run serve",
    "start": "npm run serve",
    "build": "echo 'No build step required for static site'",
    "pretest": "npm run lint",
    "predeploy": "npm run lint && npm run test",
    "postinstall": "echo '✅ Dependencies installed. Run npm run dev to start development server'",
    "clean": "rimraf coverage playwright-report test-results .eslintcache",
    "setup": "npm install && echo '🚀 Project setup complete! Run npm run dev to start'",
    "check": "npm run lint && npm run format:check && npm run test && npm run audit",
    "fix": "npm run lint:fix && npm run format && npm run audit:fix"
  },
  "keywords": [
    "personal-website",
    "rpg-game",
    "javascript",
    "static-site"
  ],
  "author": "Silas Anderson",
  "license": "MIT",
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.48.0",
    "@types/jest": "^29.5.12",
    "audit-ci": "^6.6.1",
    "eslint": "^8.57.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.0",
    "wait-on": "^8.0.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "collectCoverageFrom": [
      "script.js",
      "!node_modules/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  }
}
