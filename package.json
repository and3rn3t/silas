{
  "name": "silas-anderson-website",
  "version": "1.0.0",
  "description": "Personal website with embedded RPG game for Silas Anderson",
  "main": "script.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "serve": "npx http-server . -p 3000 -c-1",
    "deploy": "npx wrangler pages deploy . --project-name silas-anderson",
    "lint": "eslint *.js",
    "lint:fix": "eslint *.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lighthouse": "lhci autorun",
    "audit": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix"
  },
  "keywords": [
    "personal-website",
    "rpg-game",
    "javascript",
    "static-site"
  ],
  "author": "Silas Anderson",
  "license": "MIT",
  "devDependencies": {
    "@lhci/cli": "^0.12.0",
    "@playwright/test": "^1.48.0",
    "@types/jest": "^29.5.12",
    "audit-ci": "^6.6.1",
    "eslint": "^8.57.0",
    "prettier": "^3.1.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "collectCoverageFrom": [
      "script.js",
      "!node_modules/**"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  }
}
